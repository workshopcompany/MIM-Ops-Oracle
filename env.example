# ═══════════════════════════════════════════════════════════════════════
# MIM-Ops Pro Environment Variables
# 사용 방법: cp .env.example .env 후 값 수정
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────── Flask API Server ───────────────────
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=false

# API 인증키 (프로덕션에서는 반드시 변경!)
API_KEY=your-secure-api-key-here-change-in-production

# ─────────────────── Oracle Cloud Configuration ───────────────────

# Oracle Cloud Object Storage 사용 여부
USE_ORACLE=true

# Oracle Cloud 계정정보
# ~/.oci/config 파일이 있으면 자동으로 읽음
ORACLE_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORACLE_BUCKET_NAME=mim-ops-results
ORACLE_REGION=ap-seoul-1  # 또는 ap-tokyo-1, us-phoenix-1 등

# ─────────────────── File & Storage ───────────────────

# 로컬 임시 디렉토리
TEMP_DIR=/tmp/mim-ops

# 결과 저장 디렉토리
RESULTS_DIR=./results

# 최대 파일 크기 (바이트)
MAX_FILE_SIZE=104857600  # 100MB

# ─────────────────── Solver Configuration ───────────────────

# 솔버 타임아웃 (초)
SOLVER_TIMEOUT=3600  # 1시간

# 기본 메쉬 해상도 (mm)
MESH_RES_MM=0.5

# ─────────────────── Streamlit Configuration ───────────────────

# API 서버 주소 (Streamlit에서 사용)
ORACLE_API_URL=http://localhost:5000

# API 인증키 (Streamlit에서 사용)
ORACLE_API_KEY=your-secure-api-key-here-change-in-production

# ─────────────────── Development ───────────────────

# 로그 레벨
LOG_LEVEL=INFO

# CORS 허용 원본
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ─────────────────── Optional: Slack Notifications ───────────────────

# 시뮬레이션 완료 알림 (선택사항)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─────────────────── Optional: Email Notifications ───────────────────

# SMTP 설정 (선택사항)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ═════════════════════════════════════════════════════════════════════════
# 주의사항:
# 1. 프로덕션에서는 반드시 API_KEY와 ORACLE_API_KEY를 변경하세요
# 2. Oracle Cloud 설정:
#    - OCI CLI 설치: https://docs.oracle.com/en-us/iaas/Content/API/SDKDocs/cliinstall.htm
#    - oci setup config 실행하여 ~/.oci/config 생성
#    - 필요한 권한: Object Storage Read/Write, Compute Access
# 3. 이 파일을 .gitignore에 추가하세요 (민감한 정보 포함)
# ═════════════════════════════════════════════════════════════════════════
